# =========================
# Root .env.example
# =========================
# Copie para .env e preencha os valores.

# Ambiente
NODE_ENV=development

# URL pública da aplicação (usado como fallback para OAuth)
APP_URL=https://seu-dominio.app

# OAuth Discord (Server)
CLIENT_ID=seu_client_id
CLIENT_SECRET=seu_client_secret
CALLBACK_URL=https://seu-dominio.app/callback

# Sessão
SESSION_SECRET=troque_por_um_valor_seguro

# Banco PostgreSQL (Server)
DATABASE_URL=postgresql://user:password@host:5432/database

# Guild / permissões Discord
GUILD_ID=seu_guild_id
BOT_TOKEN=seu_bot_token
ADMIN_ROLE_ID=seu_admin_role_id
PROFESSOR_ROLE_ID=seu_professor_role_id
ALUNO_ROLE_ID=seu_aluno_role_id

# Bot Discord
DISCORD_TOKEN=seu_discord_token