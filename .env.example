# =========================
# Root .env.example
# =========================
# Copie para .env e preencha os valores.

# Ambiente
NODE_ENV=development

# URL pública da aplicação (usado como fallback para OAuth)
APP_URL=http://localhost:3000

# OAuth Discord (Server)
CLIENT_ID=seu_client_id_do_discord_app
CLIENT_SECRET=seu_client_secret_do_discord_app
CALLBACK_URL=http://localhost:3000/callback

# Sessão
SESSION_SECRET=gerar_uma_chave_segura_aqui

# Banco PostgreSQL (Server)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Guild / permissões Discord
GUILD_ID=seu_guild_id_do_servidor
BOT_TOKEN=seu_bot_token_do_discord
ADMIN_ROLE_ID=seu_role_id_de_admin
PROFESSOR_ROLE_ID=seu_role_id_de_professor
ALUNO_ROLE_ID=seu_role_id_de_aluno

# Bot Discord
DISCORD_TOKEN=seu_bot_token_do_discord